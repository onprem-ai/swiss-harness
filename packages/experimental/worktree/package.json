{
  "name": "@onprem-ai/dsh-experimental-worktree",
  "description": "Creates a named Git worktree and changes the calling Session working directory",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/worktree"
  },
  "dependencies": {
    "@onprem-ai/schemastery": "workspace:~",
    "@onprem-ai/dsh-timeout": "workspace:*"
  },
  "peerDependencies": {
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/dsh-agent": "workspace:*",
    "@onprem-ai/dsh-fs": "workspace:*",
    "@onprem-ai/dsh-sandbox": "workspace:*",
    "@onprem-ai/dsh-sandbox-policy": "workspace:*",
    "@onprem-ai/dsh-subprocess": "workspace:*",
    "@onprem-ai/dsh-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/dsh-agent": "workspace:*",
    "@onprem-ai/dsh-agent-loop-testkit": "workspace:*",
    "@onprem-ai/dsh-fs": "workspace:*",
    "@onprem-ai/dsh-fs-local": "workspace:*",
    "@onprem-ai/dsh-sandbox": "workspace:*",
    "@onprem-ai/dsh-sandbox-local": "workspace:*",
    "@onprem-ai/dsh-sandbox-policy": "workspace:*",
    "@onprem-ai/dsh-session": "workspace:*",
    "@onprem-ai/dsh-session-projection": "workspace:*",
    "@onprem-ai/dsh-subprocess": "workspace:*",
    "@onprem-ai/dsh-subprocess-local": "workspace:*",
    "@onprem-ai/dsh-system-prompt": "workspace:*",
    "@onprem-ai/dsh-working-directory": "workspace:*"
  }
}
