{
  "name": "@onprem-ai/dsh-plugin-market",
  "description": "Configured plugin market indexes for the Web Discover page and the plugin_market agent tool",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/plugin-market"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@onprem-ai/dsh-app-boot": "workspace:*",
    "@onprem-ai/dsh-package-manifest": "workspace:*",
    "@onprem-ai/dsh-plugin-market-index": "workspace:*",
    "@onprem-ai/dsh-timeout": "workspace:*",
    "@onprem-ai/dsh-util-values": "workspace:*",
    "@onprem-ai/schemastery": "workspace:~",
    "minisearch": "^7.2.0",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/cordis-plugin-loader": "workspace:~",
    "@onprem-ai/dsh-plugin-manager": "workspace:*",
    "@onprem-ai/dsh-settings": "workspace:*",
    "@onprem-ai/dsh-tools": "workspace:*",
    "@onprem-ai/dsh-typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@onprem-ai/dsh-settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/cordis-plugin-loader": "workspace:~",
    "@onprem-ai/cosmokit": "workspace:~",
    "@onprem-ai/dsh-app-boot": "workspace:*",
    "@onprem-ai/dsh-config-editor": "workspace:*",
    "@onprem-ai/dsh-llm": "workspace:*",
    "@onprem-ai/dsh-plugin-manager": "workspace:*",
    "@onprem-ai/dsh-settings": "workspace:*",
    "@onprem-ai/dsh-system-prompt": "workspace:*",
    "@onprem-ai/dsh-tools": "workspace:*",
    "@onprem-ai/dsh-typert-protocol": "workspace:*",
    "@types/semver": "^7.8.0"
  }
}
