{
  "name": "@onprem-ai/dsh-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@onprem-ai/cordis-plugin-timer": "workspace:~",
    "@onprem-ai/dsh-agent": "workspace:*",
    "@onprem-ai/dsh-agent-loop": "workspace:*",
    "@onprem-ai/dsh-attachment-local": "workspace:*",
    "@onprem-ai/dsh-compaction-basic": "workspace:*",
    "@onprem-ai/dsh-compaction-image-offload": "workspace:*",
    "@onprem-ai/dsh-deepseek-llm-api-extensions": "workspace:*",
    "@onprem-ai/dsh-jobs-local": "workspace:*",
    "@onprem-ai/dsh-llm": "workspace:*",
    "@onprem-ai/dsh-llm-deepseek-api-key": "workspace:*",
    "@onprem-ai/dsh-llm-retry": "workspace:*",
    "@onprem-ai/dsh-mcp-resources": "workspace:*",
    "@onprem-ai/dsh-plugin-package-inventory-deepseek": "workspace:*",
    "@onprem-ai/dsh-sandbox-local": "workspace:*",
    "@onprem-ai/dsh-sandbox-policy": "workspace:*",
    "@onprem-ai/dsh-sdk-app": "workspace:*",
    "@onprem-ai/dsh-sdk-jsonrpc-server": "workspace:*",
    "@onprem-ai/dsh-session": "workspace:*",
    "@onprem-ai/dsh-session-log-deepseek": "workspace:*",
    "@onprem-ai/dsh-session-persistence-jsonl": "workspace:*",
    "@onprem-ai/dsh-session-projection": "workspace:*",
    "@onprem-ai/dsh-session-title": "workspace:*",
    "@onprem-ai/dsh-subprocess-local": "workspace:*",
    "@onprem-ai/dsh-system-prompt": "workspace:*",
    "@onprem-ai/dsh-terminal": "workspace:*",
    "@onprem-ai/dsh-terminal-bash": "workspace:*",
    "@onprem-ai/dsh-token-meter": "workspace:*",
    "@onprem-ai/dsh-tool-bash-persistent": "workspace:*",
    "@onprem-ai/dsh-tool-fs": "workspace:*",
    "@onprem-ai/dsh-tool-pwsh-persistent": "workspace:*",
    "@onprem-ai/dsh-tools": "workspace:*",
    "@onprem-ai/dsh-working-directory": "workspace:*",
    "@onprem-ai/dsh-tool-working-directory": "workspace:*",
    "@onprem-ai/dsh-fs-local": "workspace:*"
  },
  "peerDependencies": {
    "@onprem-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@onprem-ai/cordis": "workspace:~"
  }
}
