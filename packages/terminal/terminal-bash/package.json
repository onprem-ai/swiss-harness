{
  "name": "@onprem-ai/dsh-terminal-bash",
  "description": "Persistent shell PTY backend over the DeepSeek Harness subprocess terminal primitive",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@onprem-ai/dsh-agent": "workspace:*",
    "@onprem-ai/dsh-terminal": "workspace:*",
    "@onprem-ai/dsh-sandbox": "workspace:*",
    "@onprem-ai/dsh-sandbox-policy": "workspace:*",
    "@onprem-ai/dsh-session": "workspace:*",
    "@onprem-ai/dsh-subprocess": "workspace:*",
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/dsh-session-projection": "workspace:*",
    "@onprem-ai/dsh-working-directory": "workspace:*"
  },
  "dependencies": {
    "@onprem-ai/dsh-lazy-require": "workspace:*",
    "@onprem-ai/dsh-pwsh-local": "workspace:*",
    "@onprem-ai/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@onprem-ai/dsh-agent": "workspace:*",
    "@onprem-ai/dsh-agent-loop-testkit": "workspace:*",
    "@onprem-ai/dsh-terminal": "workspace:*",
    "@onprem-ai/dsh-sandbox": "workspace:*",
    "@onprem-ai/dsh-sandbox-policy": "workspace:*",
    "@onprem-ai/dsh-session": "workspace:*",
    "@onprem-ai/dsh-subprocess": "workspace:*",
    "@onprem-ai/dsh-subprocess-local": "workspace:*",
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/dsh-working-directory": "workspace:*"
  }
}
