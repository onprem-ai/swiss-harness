{
  "name": "@onprem-ai/dsh-agent-instructions",
  "description": "Workspace context loader for AGENTS.md/CLAUDE.md instruction files",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/context/agent-instructions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/dsh-agent": "workspace:*",
    "@onprem-ai/dsh-fs": "workspace:*",
    "@onprem-ai/dsh-home-paths": "workspace:*",
    "@onprem-ai/dsh-llm": "workspace:*",
    "@onprem-ai/dsh-session": "workspace:*",
    "@onprem-ai/dsh-session-projection": "workspace:*",
    "@onprem-ai/dsh-tools": "workspace:*",
    "@onprem-ai/dsh-working-directory": "workspace:*"
  },
  "dependencies": {
    "@onprem-ai/dsh-util-values": "workspace:*",
    "@onprem-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/cordis-plugin-loader": "workspace:~",
    "@onprem-ai/dsh-agent": "workspace:*",
    "@onprem-ai/dsh-agent-loop": "workspace:*",
    "@onprem-ai/dsh-agent-loop-testkit": "workspace:*",
    "@onprem-ai/dsh-fs": "workspace:*",
    "@onprem-ai/dsh-fs-local": "workspace:*",
    "@onprem-ai/dsh-home-paths": "workspace:*",
    "@onprem-ai/dsh-llm": "workspace:*",
    "@onprem-ai/dsh-llm-deepseek": "workspace:*",
    "@onprem-ai/dsh-llm-deepseek-api-key": "workspace:*",
    "@onprem-ai/dsh-session": "workspace:*",
    "@onprem-ai/dsh-session-projection": "workspace:*",
    "@onprem-ai/dsh-system-prompt": "workspace:*",
    "@onprem-ai/dsh-tool-fs": "workspace:*",
    "@onprem-ai/dsh-tools": "workspace:*",
    "@onprem-ai/dsh-working-directory": "workspace:*"
  }
}
