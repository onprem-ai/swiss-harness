{
  "name": "@onprem-ai/dsh-tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@onprem-ai/dsh-agent": "workspace:*",
    "@onprem-ai/dsh-shell": "workspace:*",
    "@onprem-ai/dsh-shell-env": "workspace:*",
    "@onprem-ai/dsh-llm": "workspace:*",
    "@onprem-ai/dsh-sandbox": "workspace:*",
    "@onprem-ai/dsh-sandbox-policy": "workspace:*",
    "@onprem-ai/dsh-system-prompt": "workspace:*",
    "@onprem-ai/dsh-jobs": "workspace:*",
    "@onprem-ai/dsh-tools": "workspace:*",
    "@onprem-ai/dsh-user-approval": "workspace:*",
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/dsh-working-directory": "workspace:*"
  },
  "dependencies": {
    "@onprem-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@onprem-ai/dsh-ptc-runtime": "workspace:*",
    "@onprem-ai/dsh-agent": "workspace:*",
    "@onprem-ai/dsh-agent-loop": "workspace:*",
    "@onprem-ai/dsh-agent-loop-testkit": "workspace:*",
    "@onprem-ai/dsh-shell": "workspace:*",
    "@onprem-ai/dsh-shell-env": "workspace:*",
    "@onprem-ai/dsh-bash-local": "workspace:*",
    "@onprem-ai/dsh-llm": "workspace:*",
    "@onprem-ai/dsh-subprocess-local": "workspace:*",
    "@onprem-ai/dsh-sandbox": "workspace:*",
    "@onprem-ai/dsh-sandbox-policy": "workspace:*",
    "@onprem-ai/dsh-session": "workspace:*",
    "@onprem-ai/dsh-session-persistence-jsonl": "workspace:*",
    "@onprem-ai/dsh-system-prompt": "workspace:*",
    "@onprem-ai/dsh-jobs": "workspace:*",
    "@onprem-ai/dsh-jobs-local": "workspace:*",
    "@onprem-ai/dsh-tool-jobs": "workspace:*",
    "@onprem-ai/dsh-tools": "workspace:*",
    "@onprem-ai/dsh-user-approval": "workspace:*",
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/dsh-session-projection": "workspace:*",
    "@onprem-ai/dsh-working-directory": "workspace:*"
  }
}
