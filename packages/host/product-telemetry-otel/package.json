{
  "name": "@onprem-ai/dsh-host-product-telemetry-otel",
  "description": "Explicit product usage events exported through OpenTelemetry HTTP logs",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/product-telemetry-otel"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@onprem-ai/schemastery": "workspace:~",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/otlp-exporter-base": "^0.220.0",
    "@opentelemetry/sdk-logs": "^0.220.0"
  },
  "peerDependencies": {
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/dsh-otel": "workspace:*"
  },
  "devDependencies": {
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/cordis-plugin-loader": "workspace:~",
    "@onprem-ai/dsh-app-boot": "workspace:*",
    "@onprem-ai/dsh-loader-smoke": "workspace:*",
    "@onprem-ai/dsh-otel": "workspace:*"
  }
}
