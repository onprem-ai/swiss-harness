{
  "name": "@onprem-ai/dsh-client-ui-workspace",
  "description": "Workspace picker plugin: one WorkspacePicker registered into the sidebar and empty-state workspace slots",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-workspace"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@onprem-ai/dsh-api-remotes",
        "@onprem-ai/dsh-api-session-controller",
        "@onprem-ai/dsh-api-workspace-controller",
        "@onprem-ai/dsh-client-connection",
        "@onprem-ai/dsh-client-locale",
        "@onprem-ai/dsh-client-shortcuts",
        "@onprem-ai/dsh-client-ui-conversation",
        "@onprem-ai/dsh-client-ui-layout",
        "@onprem-ai/dsh-client-ui-renderer",
        "@onprem-ai/dsh-client-ui-session",
        "@onprem-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@onprem-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/dsh-api-remotes": "workspace:*",
    "@onprem-ai/dsh-agent": "workspace:*",
    "@onprem-ai/dsh-api-session-controller": "workspace:*",
    "@onprem-ai/dsh-api-workspace-controller": "workspace:*",
    "@onprem-ai/dsh-client-connection": "workspace:*",
    "@onprem-ai/dsh-client-locale": "workspace:*",
    "@onprem-ai/dsh-client-store": "workspace:*",
    "@onprem-ai/dsh-client-test-runtime": "workspace:*",
    "@onprem-ai/dsh-client-ui-conversation": "workspace:*",
    "@onprem-ai/dsh-client-ui-layout": "workspace:*",
    "@onprem-ai/dsh-client-ui-primitives": "workspace:*",
    "@onprem-ai/dsh-client-ui-renderer": "workspace:*",
    "@onprem-ai/dsh-client-ui-session": "workspace:*",
    "@onprem-ai/dsh-client-ui-sidebar": "workspace:*",
    "@onprem-ai/dsh-client-ui-slots": "workspace:*",
    "@onprem-ai/dsh-jobs": "workspace:*",
    "@onprem-ai/dsh-schedule": "workspace:*",
    "@onprem-ai/dsh-session": "workspace:*",
    "@onprem-ai/dsh-subagent": "workspace:*",
    "@onprem-ai/dsh-typert-protocol": "workspace:*",
    "@onprem-ai/dsh-util-values": "workspace:*",
    "@onprem-ai/dsh-util-workspace-path": "workspace:*",
    "@types/react": "~18.3.1",
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "@onprem-ai/dsh-client-shortcuts": "workspace:*",
    "@onprem-ai/dsh-client-product-analytics": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
