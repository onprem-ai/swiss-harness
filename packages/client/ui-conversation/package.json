{
  "name": "@onprem-ai/dsh-client-ui-conversation",
  "description": "Target-neutral Conversation assembly, shell, composer, queue, and view navigation",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@onprem-ai/dsh-api-session-controller",
        "@onprem-ai/dsh-client-file-upload",
        "@onprem-ai/dsh-client-locale",
        "@onprem-ai/dsh-client-ui-layout",
        "@onprem-ai/dsh-client-ui-renderer",
        "@onprem-ai/dsh-client-ui-session",
        "@onprem-ai/dsh-client-ui-settings",
        "@onprem-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@onprem-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@onprem-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/dsh-api-remotes": "workspace:*",
    "@onprem-ai/dsh-api-session-controller": "workspace:*",
    "@onprem-ai/dsh-api-workspace-controller": "workspace:*",
    "@onprem-ai/dsh-attachment": "workspace:*",
    "@onprem-ai/dsh-brand": "workspace:*",
    "@onprem-ai/dsh-client-locale": "workspace:*",
    "@onprem-ai/dsh-client-file-upload": "workspace:*",
    "@onprem-ai/dsh-client-store": "workspace:*",
    "@onprem-ai/dsh-client-test-runtime": "workspace:*",
    "@onprem-ai/dsh-client-ui-layout": "workspace:*",
    "@onprem-ai/dsh-client-ui-primitives": "workspace:*",
    "@onprem-ai/dsh-client-ui-renderer": "workspace:*",
    "@onprem-ai/dsh-client-ui-session": "workspace:*",
    "@onprem-ai/dsh-client-ui-settings": "workspace:*",
    "@onprem-ai/dsh-client-ui-workspace": "workspace:*",
    "@onprem-ai/dsh-client-ui-slots": "workspace:*",
    "@onprem-ai/dsh-commands": "workspace:*",
    "@onprem-ai/dsh-goal": "workspace:*",
    "@onprem-ai/dsh-llm": "workspace:*",
    "@onprem-ai/dsh-llm-retry": "workspace:*",
    "@onprem-ai/dsh-plan-mode": "workspace:*",
    "@onprem-ai/dsh-session": "workspace:*",
    "@onprem-ai/dsh-util-values": "workspace:*",
    "@onprem-ai/dsh-token-meter": "workspace:*",
    "@onprem-ai/dsh-tool-todo": "workspace:*",
    "@onprem-ai/dsh-util-crypto": "workspace:*",
    "@onprem-ai/dsh-workspace": "workspace:*",
    "@onprem-ai/dsh-file-reference": "workspace:*",
    "@onprem-ai/dsh-util-workspace-path": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@lexical/headless": "^0.49.0",
    "react-dom": "^18.2.0",
    "@types/react-dom": "~18.3.0",
    "zod": "^4.4.3",
    "lexical": "^0.49.0",
    "clsx": "^2.0.0",
    "@lexical/utils": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/history": "^0.49.0",
    "@onprem-ai/dsh-agent": "workspace:*",
    "@onprem-ai/dsh-settings": "workspace:*",
    "@onprem-ai/dsh-client-shortcuts": "workspace:*",
    "@onprem-ai/dsh-client-product-analytics": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
