{
  "name": "@onprem-ai/dsh-client-ui-sidebar-right",
  "description": "Right Sidebar: the docking surface's session-bound state, its panel and header expand control, and the navigation service over it",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-sidebar-right"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@onprem-ai/dsh-api-session-controller",
        "@onprem-ai/dsh-client-resources",
        "@onprem-ai/dsh-client-ui-conversation",
        "@onprem-ai/dsh-client-ui-layout",
        "@onprem-ai/dsh-client-ui-session",
        "@onprem-ai/dsh-client-shortcuts"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@onprem-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/dsh-api-session-controller": "workspace:*",
    "@onprem-ai/dsh-client-locale": "workspace:*",
    "@onprem-ai/dsh-client-resources": "workspace:*",
    "@onprem-ai/dsh-client-store": "workspace:*",
    "@onprem-ai/dsh-client-test-runtime": "workspace:*",
    "@onprem-ai/dsh-client-ui-conversation": "workspace:*",
    "@onprem-ai/dsh-client-ui-dockkit": "workspace:*",
    "@onprem-ai/dsh-client-ui-layout": "workspace:*",
    "@onprem-ai/dsh-client-ui-primitives": "workspace:*",
    "@onprem-ai/dsh-client-ui-renderer": "workspace:*",
    "@onprem-ai/dsh-client-ui-session": "workspace:*",
    "@onprem-ai/dsh-client-ui-slots": "workspace:*",
    "@onprem-ai/dsh-session": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/picomatch": "^4.0.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "picomatch": "^4.0.4",
    "clsx": "^2.0.0",
    "@onprem-ai/dsh-util-crypto": "workspace:*",
    "zod": "^4.4.3",
    "@onprem-ai/dsh-client-shortcuts": "workspace:*",
    "@onprem-ai/dsh-brand": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
