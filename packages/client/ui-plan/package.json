{
  "name": "@onprem-ai/dsh-client-ui-plan",
  "description": "Plan mode controls, persistent transcript plan cards, and sidebar Markdown previews",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-plan"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@onprem-ai/dsh-api-remotes",
        "@onprem-ai/dsh-client-locale",
        "@onprem-ai/dsh-client-ui-conversation",
        "@onprem-ai/dsh-client-ui-sidebar-right",
        "@onprem-ai/dsh-client-ui-chat",
        "@onprem-ai/dsh-client-ui-user-questions",
        "@onprem-ai/dsh-client-resources",
        "@onprem-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@onprem-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@onprem-ai/dsh-client-store": "workspace:*",
    "@onprem-ai/dsh-api-remotes": "workspace:*",
    "@onprem-ai/dsh-client-locale": "workspace:*",
    "@onprem-ai/dsh-client-test-runtime": "workspace:*",
    "@onprem-ai/dsh-client-ui-conversation": "workspace:*",
    "@onprem-ai/dsh-client-ui-primitives": "workspace:*",
    "@onprem-ai/dsh-client-ui-slots": "workspace:*",
    "@onprem-ai/dsh-plan-mode": "workspace:*",
    "@onprem-ai/cordis": "workspace:~",
    "react": "^18.2.0",
    "@onprem-ai/dsh-session": "workspace:*",
    "@onprem-ai/dsh-client-ui-renderer": "workspace:*",
    "@onprem-ai/dsh-client-ui-session": "workspace:*",
    "@onprem-ai/dsh-api-session-controller": "workspace:*",
    "@onprem-ai/dsh-client-ui-chat": "workspace:*",
    "@onprem-ai/dsh-client-ui-sidebar-right": "workspace:*",
    "@onprem-ai/dsh-client-ui-user-questions": "workspace:*",
    "@onprem-ai/dsh-client-resources": "workspace:*",
    "@onprem-ai/dsh-typert-protocol": "workspace:*",
    "@onprem-ai/dsh-llm": "workspace:*",
    "@onprem-ai/dsh-tools": "workspace:*",
    "@onprem-ai/dsh-util-crypto": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
