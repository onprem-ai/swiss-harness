{
  "name": "@onprem-ai/dsh-mcp-resources",
  "description": "Scoped MCP resource discovery and reading through shared model tools",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/mcp/mcp-resources"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/dsh-llm": "workspace:*",
    "@onprem-ai/dsh-scope": "workspace:*",
    "@onprem-ai/dsh-system-prompt": "workspace:*",
    "@onprem-ai/dsh-tools": "workspace:*"
  },
  "devDependencies": {
    "@onprem-ai/cordis": "workspace:~",
    "@onprem-ai/dsh-llm": "workspace:*",
    "@onprem-ai/dsh-ptc-runtime": "workspace:*",
    "@onprem-ai/dsh-scope": "workspace:*",
    "@onprem-ai/dsh-tools": "workspace:*",
    "@onprem-ai/dsh-system-prompt": "workspace:*",
    "@onprem-ai/dsh-agent": "workspace:*"
  },
  "dependencies": {
    "@onprem-ai/dsh-util-values": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@onprem-ai/dsh-system-prompt": {
      "optional": true
    }
  }
}
